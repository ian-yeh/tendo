{
  "name": "@ianyeh/tendo",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Eyes and hands for coding agents. Let an LLM see a web page and act on it, with zero setup.",
  "main": "dist/index.js",
  "bin": {
    "tendo": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "postinstall": "node scripts/postinstall.cjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "browser",
    "automation",
    "playwright",
    "agent",
    "llm",
    "ai",
    "cli",
    "screenshot",
    "web-scraping",
    "browser-automation"
  ],
  "author": "Ian Yeh",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/ian-yeh/tendo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ian-yeh/tendo.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/ian-yeh/tendo/issues"
  },
  "devDependencies": {
    "@tendo/browser": "*",
    "@tendo/core": "*",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3"
  }
}
